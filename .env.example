# Supabase 프로젝트 주소 (프로젝트 설정 > API)
EXPO_PUBLIC_SUPABASE_URL=https://<프로젝트-ref>.supabase.co
# Supabase publishable(공개) 키
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버의 FREE_MONTHLY_LIMIT와 같게 맞추세요 (화면 표시용)
EXPO_PUBLIC_FREE_MONTHLY_LIMIT=5
# Store product ids for AI credit packs, comma separated (same id on Google Play and App Store Connect)
EXPO_PUBLIC_IAP_PRODUCT_IDS=launch_pass
